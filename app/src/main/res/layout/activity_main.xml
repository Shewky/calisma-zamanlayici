<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- İpek'e Özel Neşeli Karşılama Kartı -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_card"
            android:orientation="vertical"
            android:padding="22dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvWelcomeIpek"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Merhaba İpek! 🌸🌟"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWelcomeSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="4. Sınıf Başarı Yolculuğunda Bugün Harika İşler Yapacaksın!"
                android:textColor="#FFF5FA"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvTodaySummaryBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#33FFFFFF"
                android:padding="10dp"
                android:text="🎯 Bugünkü Çalışman: Yükleniyor..."
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Aktif 40 Dakikalık Döngü Hafıza Bilgisi -->
        <LinearLayout
            android:id="@+id/layoutCycleMemoryBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_white_card"
            android:orientation="vertical"
            android:padding="14dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvCycleMemoryInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⏱️ 40 Dakikalık Döngü Durumu: Yeni döngüye hazır (40 dk 00 sn)"
                android:textColor="@color/text_dark"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnResumeActiveTimer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/btn_orange_rounded"
                android:text="▶️ Devam Eden Zamanlayıcı Ekranını Aç"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Ana Çalışma Seçenekleri: Ödeve Başla & Test Çözümleri -->
        <Button
            android:id="@+id/btnStartHomework"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/btn_pink_rounded"
            android:text="📚 Ödeve Başla"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnStartTest"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/btn_purple_rounded"
            android:text="📝 Test Çözümleri"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold" />

        <!-- Takvim ve Başarı Ödülleri Butonları -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="14dp">

            <Button
                android:id="@+id/btnOpenCalendar"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/btn_mint_rounded"
                android:text="📅 Çalışma Takvimi"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnOpenRewards"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/btn_orange_rounded"
                android:text="🏆 Başarı Ödüllerim"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Ses Testi ve Otomatik Güncelleme Alanı -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_white_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvAppVersionInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sürüm: v1.0.1 • Android 6+ Arka Plan Sesli Uyarı Aktif"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <Button
                    android:id="@+id/btnTestVoice"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/btn_pink_rounded"
                    android:text="🔊 Anons Sesi Testi"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnCheckUpdate"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/btn_purple_rounded"
                    android:text="🔄 Güncelleme Bul"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
