<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollRootMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- İLK GİRİŞ (ONBOARDING) EKRANI -->
        <LinearLayout
            android:id="@+id/layoutOnboardingContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_white_card"
            android:orientation="vertical"
            android:padding="22dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🌟 Çalışma Zamanlayıcı'ya Hoş Geldin!"
                android:textColor="@color/text_dark"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Başlamadan önce bilgilerini seçelim:"
                android:textColor="@color/text_muted"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="İsmin nedir?"
                android:textColor="@color/text_dark"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etOnboardName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:hint="İsmini buraya yaz..."
                android:inputType="textPersonName|textCapWords"
                android:padding="12dp"
                android:textColor="@color/text_dark"
                android:textSize="17sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Kaçıncı sınıftasın? (1. - 8. Sınıf):"
                android:textColor="@color/text_dark"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerOnboardGrade"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Seçiminiz (tema seçeneği için):"
                android:textColor="@color/text_dark"
                android:textSize="16sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgOnboardGender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbOnboardGirl"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:checked="true"
                    android:text="👧 Kız (tema seçeneği için)"
                    android:textColor="@color/text_dark"
                    android:textSize="16sp" />

                <RadioButton
                    android:id="@+id/rbOnboardBoy"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="👦 Erkek (tema seçeneği için)"
                    android:textColor="@color/text_dark"
                    android:textSize="16sp" />
            </RadioGroup>

            <Button
                android:id="@+id/btnCompleteOnboarding"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="18dp"
                android:text="🚀 Giriş Yap ve Başla"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ANA UYGULAMA EKRANI -->
        <LinearLayout
            android:id="@+id/layoutDashboardContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Üst Karşılama Kartı + Sağ Üstte Ayarlar Butonu -->
            <LinearLayout
                android:id="@+id/layoutMainHeaderCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvWelcomeUser"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Merhaba! 🌟"
                        android:textColor="#FFFFFF"
                        android:textSize="23sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnOpenSettings"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:background="#33FFFFFF"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="⚙️ Ayarlar"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvWelcomeSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Başarı Yolculuğunda Bugün Harika İşler Yapacaksın!"
                    android:textColor="#F8FAFC"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvTodaySummaryBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="#28FFFFFF"
                    android:padding="10dp"
                    android:text="🎯 Bugünkü Çalışman: Yükleniyor..."
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Aktif 40 Dakikalık Döngü Hafıza Bilgisi -->
            <LinearLayout
                android:id="@+id/layoutCycleMemoryBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_white_card"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:id="@+id/tvCycleMemoryInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⏱️ 40 Dakikalık Döngü Durumu: Yeni döngüye hazır (40 dk 00 sn)"
                    android:textColor="@color/text_dark"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnResumeActiveTimer"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:text="▶️ Devam Eden Zamanlayıcı Ekranını Aç"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Ana Çalışma Seçenekleri: Ödeve Başla, Test Çözümleri, Kitap Oku -->
            <Button
                android:id="@+id/btnStartHomework"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginBottom="10dp"
                android:text="📚 Ödeve Başla"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnStartTest"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginBottom="10dp"
                android:text="📝 Test Çözümleri"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnStartBookRead"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginBottom="10dp"
                android:text="📖 Kitap Oku"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnOpenEntertainment"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginBottom="12dp"
                android:text="🔒 Eğlence (40 Dk Çalışma Gerekli)"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Takvim ve Başarı Ödülleri Butonları -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/btnOpenCalendar"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="📅 Çalışma Takvimi"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnOpenRewards"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="🏆 Başarı Ödüllerim"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- YENİ: Veli Eşleştirme (Karekod) & Anne/Baba Sesli Çağrı Gönderme Kartı -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_white_card"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="👨‍👩‍👧 Veli Eşleştirme ve Sesli Çağrı"
                    android:textColor="@color/text_dark"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvParentConnectionStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Aynı Wi-Fi ağında Anne veya Baba ile eşleşip görüşebilirsin."
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <Button
                        android:id="@+id/btnCallAnne"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="👩 Anne'ye Çağrı"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnCallBaba"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="👨 Baba'ya Çağrı"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnOpenParentQr"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:text="📱 Anne / Baba Eşleştirme Karekodu Göster"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Ses Testi ve Otomatik Güncelleme Alanı -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_white_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvAppVersionInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sürüm: v3.0 • Android 6+ Arka Plan Sesli Uyarı Aktif"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <Button
                        android:id="@+id/btnTestVoice"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="🔊 Anons Sesi Testi"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnCheckUpdate"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="🔄 Güncelleme Bul"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
