<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollRootQr"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:id="@+id/layoutQrHeaderCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📱 Veli Eşleştirme Karekodu"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Anne veya Baba için oluşturulan karekodu Veli Uygulamasından okutarak eşleştirebilirsiniz."
                android:textColor="#F8FAFC"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Anne / Baba Karekod Seçim Butonları -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="14dp">

            <Button
                android:id="@+id/btnShowAnneQr"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="👩 Anne Karekodu"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnShowBabaQr"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="👨 Baba Karekodu"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_white_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:id="@+id/tvQrRoleTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👩 ANNE İÇİN EŞLEŞTİRME KAREKODU"
                android:textColor="@color/text_dark"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <ImageView
                android:id="@+id/ivQrCodeBitmap"
                android:layout_width="260dp"
                android:layout_height="260dp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/tvQrNetworkInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Cihaz IP: Yükleniyor..."
                android:textColor="@color/text_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnBackFromQr"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_white_card"
            android:text="⬅️ Ana Ekrana Dön"
            android:textAllCaps="false"
            android:textColor="@color/text_dark"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
