<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollRootCalendar"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/layoutCalendarHeaderCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:id="@+id/tvCalendarHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📅 Çalışma ve Okuma Takvimi"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Takvimden bir güne tıklayarak o gün yapılan ödev, çözülen test ve okunan kitap sürelerini görebilirsin!"
                android:textColor="#F8FAFC"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_white_card"
            android:orientation="vertical"
            android:padding="8dp"
            android:layout_marginBottom="14dp">

            <CalendarView
                android:id="@+id/calendarViewStudy"
                android:layout_width="match_parent"
                android:layout_height="310dp" />
        </LinearLayout>

        <!-- Seçilen Günün Kayıtları -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_white_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:id="@+id/tvSelectedDateTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📌 Seçilen Gün: Bugün"
                android:textColor="@color/text_dark"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSelectedDateSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Toplam Ödev: 0 dk • Test: 0 dk • Kitap: 0 dk"
                android:textColor="@color/text_muted"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layoutDateRecordsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />
        </LinearLayout>

        <Button
            android:id="@+id/btnBackFromCalendar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="⬅️ Ana Ekrana Dön"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
