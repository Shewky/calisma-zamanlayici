<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_card"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:id="@+id/tvSubjectHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="İpek, Hangi Dersi Seçiyoruz? 🌈"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubjectModeSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="4. Sınıf Ders Seçimi"
                android:textColor="#FFF5FA"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Önceki dersten devreden süre bilgisini gösteren kutu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_white_card"
            android:orientation="vertical"
            android:padding="14dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:id="@+id/tvCarriedTimeNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⏱️ Seçtiğin derste 40 dakikalık çalışma süresi başlayacak."
                android:textColor="@color/text_dark"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnResetCycleMemory"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginTop="8dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/btn_orange_rounded"
                android:text="🔄 Süreyi 40 Dakikaya Sıfırla"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 4. Sınıf Ders Butonları Ekleneceği Alan -->
        <LinearLayout
            android:id="@+id/layoutSubjectButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnBackToMainFromSubjects"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_white_card"
            android:text="⬅️ Ana Ekrana Dön"
            android:textAllCaps="false"
            android:textColor="@color/text_dark"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
