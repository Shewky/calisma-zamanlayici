<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Üst Bilgi Kartı -->
        <LinearLayout
            android:id="@+id/layoutTimerBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_card"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="18dp">

            <TextView
                android:id="@+id/tvTimerIpekcheer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Başarılar İpek! 🌟"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTimerModeAndSubject"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="📚 Ödev • Türkçe"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPhaseBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#33FFFFFF"
                android:padding="8dp"
                android:text="🔔 Durum: Çalışma Süresi Aktif"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Büyük Dairesel Sayaç Görünümü -->
        <LinearLayout
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:background="@drawable/bg_timer_circle"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginBottom="18dp">

            <TextView
                android:id="@+id/tvPhaseLabelInside"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KALAN SÜRE"
                android:textColor="@color/primary_pink"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCountdownClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="40:00"
                android:textColor="@color/text_dark"
                android:textSize="54sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubjectElapsedInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Bu derste geçen süre: 00:00"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Döngü Açıklama Kartı -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_white_card"
            android:orientation="vertical"
            android:padding="14dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvLastAnnouncementText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔊 Son Sesli Anons: &quot;Çalışmaya başla&quot;"
                android:textColor="@color/accent_purple"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCycleExplanation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Ekran kapalı olsa bile süre dolduğunda 'Mola zamanı', mola bitmeye yakın 'Mola bitmek üzere' ve mola bitince 'Çalışmaya devam et' sesli uyarısı yapılır."
                android:textColor="@color/text_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- "Bu dersin ödevi bitti" / "Bu dersin testi bitti" Ana Butonu -->
        <Button
            android:id="@+id/btnFinishCurrentSubject"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/btn_mint_rounded"
            android:text="✅ Bu dersin ödevi bitti"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold" />

        <!-- Duraklat / Devam Et & İptal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/btnPauseResumeTimer"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/btn_orange_rounded"
                android:text="⏸️ Duraklat"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCancelSession"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_white_card"
                android:text="⬅️ Ders Seçimine Dön"
                android:textAllCaps="false"
                android:textColor="@color/text_dark"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
