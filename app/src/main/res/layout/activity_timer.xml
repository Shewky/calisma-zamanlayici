<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollRootTimer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Üst Bilgi Kartı -->
        <LinearLayout
            android:id="@+id/layoutTimerBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvTimerUserCheer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Başarılar! 🌟"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTimerModeAndSubject"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="📚 Ödev • Türkçe"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPhaseBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#33FFFFFF"
                android:padding="8dp"
                android:text="🔔 Durum: Başlatmayı Bekliyor"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- MOLA BİTİMİ SORU KUTUSU ("Bu dersten mi devam edeceksin?") -->
        <LinearLayout
            android:id="@+id/layoutPostBreakPrompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_white_card"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvPostBreakQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔔 10 Dakikalık Mola Süresi Bitti!
En son çalıştığın dersten mi devam edeceksin?"
                android:textColor="@color/text_dark"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPostBreakYes"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="12dp"
                android:text="✅ Evet, Bu Dersten Devam Et"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPostBreakSwitch"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_white_card"
                android:text="🔄 Hayır, Başka Ders Seç"
                android:textAllCaps="false"
                android:textColor="@color/text_dark"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Büyük Dairesel Sayaç Görünümü -->
        <LinearLayout
            android:id="@+id/layoutTimerCircle"
            android:layout_width="245dp"
            android:layout_height="245dp"
            android:background="@drawable/bg_timer_circle"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvPhaseLabelInside"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KALAN SÜRE"
                android:textColor="@color/text_muted"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCountdownClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="40:00"
                android:textColor="@color/text_dark"
                android:textSize="52sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubjectElapsedInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Bu derste geçen süre: 00:00"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- YENİ: Derse Tıkladıktan Sonra Süreyi Başlatan "BAŞLAT" Butonu -->
        <Button
            android:id="@+id/btnStartTimerNow"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginBottom="14dp"
            android:text="▶️ Başlat"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Döngü Açıklama Kartı -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_white_card"
            android:orientation="vertical"
            android:padding="14dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:id="@+id/tvLastAnnouncementText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔊 Son Sesli Anons: Hazır"
                android:textColor="@color/text_dark"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCycleExplanation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Süre dolduğunda 'çın çın' zil sesiyle 'Mola zamanı' uyarısı yapılır. Mola bitince en son çalıştığın dersi ekrana getirerek devam onayı sorar."
                android:textColor="@color/text_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- "Bu dersin ödevi bitti" / "Bu dersin testi bitti" / "Kitap okumayı bitir" Ana Butonu -->
        <Button
            android:id="@+id/btnFinishCurrentSubject"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="12dp"
            android:text="✅ Bu dersin ödevi bitti"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Duraklat / Devam Et & Geri Dön -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/btnPauseResumeTimer"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="⏸️ Duraklat"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCancelSession"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_white_card"
                android:text="⬅️ Seçim Ekranına Dön"
                android:textAllCaps="false"
                android:textColor="@color/text_dark"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
