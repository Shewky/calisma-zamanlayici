<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollRootEntertainment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Üst Başlık ve Süre/Müzik Kontrol Kartı -->
        <LinearLayout
            android:id="@+id/layoutEntHeaderCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvEntHeaderTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🎮 Eğlence Dünyası"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnToggleGameMusic"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="#33FFFFFF"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="🎵 Müzik: Açık"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvEntTimerStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#28FFFFFF"
                android:padding="8dp"
                android:text="⏱️ Eğlence Süresi: 00:00 / 12:00 (Oyunlar çalışma süresine sayılmaz)"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- OYUN SEÇİM LİSTESİ GÖRÜNÜMÜ -->
        <LinearLayout
            android:id="@+id/layoutGameLobbyContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvLobbySubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="🌟 İlerlemeli zıplama macerasını veya sınıfına özel oyunlardan birini seç!"
                android:textColor="@color/text_dark"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layoutGameCardsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <Button
                android:id="@+id/btnExitEntertainment"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_white_card"
                android:text="⬅️ Ana Ekrana Dön"
                android:textAllCaps="false"
                android:textColor="@color/text_dark"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- YENİ: İLERLEMELİ ZIPLAMALI OYUN SAHNESİ (PLATFORMER JUMP ARENA) -->
        <LinearLayout
            android:id="@+id/layoutPlatformerJumpArena"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_white_card"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvJumpGameStatus"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🏃‍♂️ Süper Yıldız Zıplama Macerası • Aşama 1"
                    android:textColor="@color/text_dark"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <FrameLayout
                    android:id="@+id/frameJumpGameCanvas"
                    android:layout_width="match_parent"
                    android:layout_height="280dp" />

                <Button
                    android:id="@+id/btnJumpAction"
                    android:layout_width="match_parent"
                    android:layout_height="62dp"
                    android:layout_marginTop="10dp"
                    android:text="⬆️ Zıpla! (Havada Çift Zıplama)"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="19sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btnBackFromJumpGame"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_white_card"
                android:text="🔄 Oyun Seçim Listesine Dön"
                android:textAllCaps="false"
                android:textColor="@color/text_dark"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- BİLGİ & MACERA OYUN SAHNESİ GÖRÜNÜMÜ -->
        <LinearLayout
            android:id="@+id/layoutActiveGameArena"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_white_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvActiveGameTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🚀 Galaksi Sayı Avcısı"
                    android:textColor="@color/text_dark"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvGameStatsBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="⭐ Puan: 0  •  🔥 Seri: 0x  •  ❤️❤️❤️"
                    android:textColor="@color/text_muted"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:id="@+id/frameEffectOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="76dp"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tvGameQuestionPrompt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:padding="14dp"
                    android:text="Görev Yükleniyor..."
                    android:textColor="@color/text_dark"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvGameFeedbackBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Doğru seçeneğe dokunarak yıldızları topla!"
                    android:textColor="@color/text_muted"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutGameOptionButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnBackToGameLobby"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_white_card"
                android:text="🔄 Oyun Seçim Listesine Dön"
                android:textAllCaps="false"
                android:textColor="@color/text_dark"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
