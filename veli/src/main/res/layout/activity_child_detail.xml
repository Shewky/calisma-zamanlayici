<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollRootChildDetail"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/veli_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Çocuk Başlık ve Anlık Durum Kartı -->
        <LinearLayout
            android:id="@+id/layoutDetailHeaderCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_veli_header"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:id="@+id/tvDetailChildName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Öğrenci Durumu"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetailLivePhase"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#33FFFFFF"
                android:padding="10dp"
                android:text="⏳ Anlık çalışma bilgisi alınıyor..."
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetailLiveTimers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Kalan Süre: --:-- • Bugün Toplam Çalışma: 0 dk"
                android:textColor="#F8FAFC"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Uzaktan Tebrik / Övgü Gönderme ve Özelleştirilmiş Övgü Kartı -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_veli_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:id="@+id/tvPraiseSectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="👏 Uzaktan Sesli Övgü / Tebrik Gönder:"
                android:textColor="@color/veli_text_dark"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSendRolePraise"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_veli_orange"
                android:text="🎉 Övgü Gönder"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSendAferinPraise"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/btn_veli_green"
                android:text="🌟 Aferin Sana Övgüsü Gönder"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCustomPraiseLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="✍️ Özelleştirilmiş Övgü / Mesaj Yaz:"
                android:textColor="@color/veli_text_dark"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etCustomPraiseInput"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:hint="Örn: Seninle gurur duyuyorum, harika çalışıyorsun!"
                android:inputType="textCapSentences"
                android:padding="10dp"
                android:textColor="@color/veli_text_dark"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnSendCustomPraise"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/btn_veli_orange"
                android:text="🔊 Özelleştirilmiş Övgü Gönder"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnDirectCallFromDetail"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/btn_veli_blue"
                android:text="📞 Şimdi Doğrudan Ara (Onaysız Görüşme Başlat)"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- YENİ: Öğrenci Uygulamasındaki Gibi Gün Gün Tıklanabilir Çalışma Takvimi (Çevrimdışı Hafızalı) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_veli_card"
            android:orientation="vertical"
            android:padding="14dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📅 Gün Gün Çalışma Takvimi (Bir güne tıklayın)"
                android:textColor="@color/veli_text_dark"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Veriler cihazınıza kaydedilir; ağdan çıksanız bile geçmişi görüntüleyebilirsiniz."
                android:textColor="@color/veli_text_muted"
                android:textSize="12sp" />

            <CalendarView
                android:id="@+id/calendarViewVeliChild"
                android:layout_width="match_parent"
                android:layout_height="305dp"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/tvVeliSelectedDateTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="📌 Seçilen Gün: Bugün"
                android:textColor="@color/veli_text_dark"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvVeliSelectedDateSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Çalışmalar (Ödev, Test, Kitap): Yükleniyor..."
                android:textColor="@color/veli_text_muted"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layoutDetailCalendarRecords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Haftalık Başarılar ve Rozetler Kartı -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_veli_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🏆 Haftalık Başarılar ve Kazanılan Ödüller"
                android:textColor="@color/veli_text_dark"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetailWeeklySummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Yükleniyor..."
                android:textColor="@color/veli_text_muted"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layoutDetailBadges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />
        </LinearLayout>

        <Button
            android:id="@+id/btnBackFromDetail"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/btn_veli_blue"
            android:text="⬅️ Veli Ana Ekranına Dön"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
